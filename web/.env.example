# Copy to .env.local. For local work, `npm run db:up` prints values for a private local Supabase.
# Use a staging Supabase project for previews: the live project's data must not be used by
# preview builds, and the new tables only exist where the migrations in supabase/migrations were applied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site address, used for canonical URLs, sitemap and link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
